<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- The scale group is a measuring instrument, not a regression test: it
         seeds up to 50,000 orders and times every report. Excluded here so CI
         does not pay for it on every build; select the group explicitly on the
         command line to run it. (Its docblock claimed this exclusion before it
         existed. Note: XML forbids a double hyphen inside a comment, which is
         why the command is described rather than quoted here; quoting it once
         stopped the whole suite from starting.) -->
    <groups>
        <exclude>
            <group>scale</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- DB connection is provided by the environment (CI sets pgsql against a
             Postgres service; see .github/workflows/deploy.yml). The schema uses
             Postgres-specific features — generated columns, inet, JSON, CHECK
             constraints — so sqlite :memory: cannot run the migrations. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
