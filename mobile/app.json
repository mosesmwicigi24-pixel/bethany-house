{
  "expo": {
    "name": "Bethany House Hub",
    "slug": "bethany-house-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bethanyhub",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ke.co.bethanyhouse.hub",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bethany House Hub checks that you are at the shop when you clock in or out. Location is read only while the clock screen is open.",
        "NSFaceIDUsageDescription": "Unlock the Hub with Face ID instead of typing your password.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] }
        ]
      }
    },
    "android": {
      "package": "ke.co.bethanyhouse.hub",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#f8f7f4" },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "USE_BIOMETRIC", "USE_FINGERPRINT", "POST_NOTIFICATIONS"],
      "blockedPermissions": ["ACCESS_BACKGROUND_LOCATION"],
      "intentFilters": [
        { "action": "VIEW", "autoVerify": true, "data": [{ "scheme": "https", "host": "hub.bethanyhouse.co.ke", "pathPrefix": "/admin" }], "category": ["BROWSABLE", "DEFAULT"] }
      ]
    },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "Bethany House Hub checks that you are at the shop when you clock in or out. Location is read only while the clock screen is open.", "isAndroidBackgroundLocationEnabled": false }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#c2410c" }],
      ["expo-local-authentication", { "faceIDPermission": "Unlock the Hub with Face ID instead of typing your password." }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#f8f7f4" }],
      "expo-secure-store"
    ],
    "extra": {
      "hubUrl": "https://hub.bethanyhouse.co.ke/admin/",
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
